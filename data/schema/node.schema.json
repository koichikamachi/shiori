{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "しおり ノード定義スキーマ",
  "type": "object",
  "required": [
    "schema_version",
    "file",
    "nodes"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "file": {
      "type": "string"
    },
    "actor_scope": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/node"
      }
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "stream",
        "actor",
        "title",
        "today_action",
        "exists_if",
        "prerequisites",
        "base_urgency",
        "priority",
        "wait",
        "durability",
        "legal_metadata"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(SELF|FAMILY|SURV)_[A-Z0-9_]+$"
        },
        "stream": {
          "enum": [
            "ESTATE_SUCCESSION",
            "POST_MORTEM_AFFAIRS",
            "BUSINESS_SUCCESSION",
            "CROSS_BORDER",
            "FAMILY_BRIDGING",
            "HANDOVER"
          ]
        },
        "actor": {
          "enum": [
            "SELF",
            "FAMILY_CHILD",
            "RELATIVES",
            "LEGAL_HEIR"
          ]
        },
        "persona_labels": {
          "type": "array",
          "items": {
            "enum": [
              "ALL",
              "PENSIONER",
              "LANDOWNER",
              "BUSINESS_OWNER",
              "FOREIGN_ASSETS",
              "DEBT_CONCERN",
              "SURPLUS_SAVINGS"
            ]
          },
          "description": "表示用のラベルのみ。出現の判定には使わない。判定は exists_if 一本で行う。"
        },
        "title": {
          "type": "string"
        },
        "today_action": {
          "type": "string"
        },
        "why_only_you": {
          "type": "string",
          "description": "本人にしかできない理由。SELF のノードにのみ置く。"
        },
        "exists_if": {
          "type": [
            "string",
            "null"
          ],
          "description": "null は無条件で存在。式に書けるのは data/schema/conditions.json にあるキーのみ。actor はここに書かない（actor フィールドで絞る）。"
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "同じ actor_scope 内のノードIDのみ。exists_if が偽で存在しないノードは、満たされたものとみなす。"
        },
        "base_urgency": {
          "enum": [
            "MUST_IMMEDIATE",
            "CAN_WAIT"
          ],
          "description": "静的な下限。実際の緊急度は deadline と days_since_death から計算して上書きする。"
        },
        "priority": {
          "type": "integer",
          "description": "小さいほど先。同点は id の昇順で決める。"
        },
        "wait": {
          "type": "object",
          "required": [
            "nature"
          ],
          "additionalProperties": false,
          "properties": {
            "nature": {
              "enum": [
                "NONE",
                "EXTERNAL_WAIT"
              ]
            },
            "reason": {
              "type": "string"
            }
          }
        },
        "durability": {
          "enum": [
            "PERMANENT",
            "REFRESHABLE",
            "VOLATILE"
          ],
          "description": "PERMANENT: 一度で済む。REFRESHABLE: 時が経つと古くなる。VOLATILE: 出来事で無効に戻る。"
        },
        "is_warning_only": {
          "type": "boolean",
          "description": "赤い帯にだけ出し、「今日の3件」には数えないノード。S02 第三部2 は『今日やること』『やらなくてよいこと』『触る前に知っておくこと』を別のものとして渡している。触る前の注意を作業として数えると、3件の枠を一つ潰す。"
        },
        "absent_note": {
          "type": "string",
          "description": "exists_if が偽で、このノードが道筋から消えたときに使う人へ伝える一文。「その作業は要りません」と言えるようにするためのもの。"
        },
        "decided_by_you": {
          "type": "boolean",
          "description": "遺族が自分で決めて動かねばならないか。false なら葬儀社等が主導する。「今日の3件」に数えるのは true のものだけ。"
        },
        "mitigates_nodes": {
          "type": "array",
          "description": "本人画面の表示専用。遺族側の道筋の計算には使わない。計算に効かせるのは相手ノードの exists_if だけである。",
          "items": {
            "type": "object",
            "required": [
              "target_node_id",
              "effect",
              "explanation"
            ],
            "additionalProperties": false,
            "properties": {
              "target_node_id": {
                "type": "string"
              },
              "effect": {
                "enum": [
                  "SKIPPED",
                  "SHORTENED",
                  "RISK_REDUCED"
                ]
              },
              "explanation": {
                "type": "string"
              }
            }
          }
        },
        "irreversibility": {
          "type": "object",
          "required": [
            "is_irreversible",
            "lost_option",
            "warning_fact",
            "warning_exception"
          ],
          "additionalProperties": false,
          "properties": {
            "is_irreversible": {
              "const": true
            },
            "lost_option": {
              "type": "string"
            },
            "warning_fact": {
              "type": "string",
              "description": "因果を断定する一文。「〜すると、〜が失われます」"
            },
            "warning_exception": {
              "type": "string",
              "description": "逃げ道を示す一文。断定した直後に必ず置く。"
            }
          }
        },
        "caution": {
          "type": "object",
          "required": [
            "note"
          ],
          "additionalProperties": false,
          "properties": {
            "note": {
              "type": "string"
            }
          },
          "description": "不可逆ではない注意。irreversibility と混ぜない。"
        },
        "deadline": {
          "type": "object",
          "required": [
            "trigger"
          ],
          "additionalProperties": false,
          "properties": {
            "days": {
              "type": [
                "integer",
                "null"
              ]
            },
            "months": {
              "type": [
                "integer",
                "null"
              ]
            },
            "absolute_date": {
              "type": [
                "string",
                "null"
              ],
              "description": "制度上の暦の期限（YYYY-MM-DD）。死亡日からの相対期限ではなく、法令が定めた固定の日。改正で動くので verified_at とあわせて管理する。"
            },
            "trigger": {
              "type": "string"
            },
            "note": {
              "type": "string"
            },
            "clock": {
              "type": "string",
              "enum": [
                "DEATH",
                "KNOWN",
                "DIVISION"
              ],
              "description": "どの時計で数えるか。DEATH=死亡日から（既定）。KNOWN=自己のために相続の開始があったことを知った時から。DIVISION=遺産分割が成立した日から。起算点が違えば、同じ死でも人によって残り日数が違う。"
            },
            "gate": {
              "type": "string",
              "enum": [
                "STAYS_OPEN",
                "CLOSES"
              ],
              "description": "期限を過ぎたときの扱い。STAYS_OPEN=過ぎても、まだやらなければならない（既定。死亡届・相続登記・相続税の申告）。CLOSES=過ぎたら、その手続そのものができなくなる（熟慮期間の伸長）。CLOSES のものを過ぎたあとに急かすと、できないことを勧めることになる。"
            },
            "closed_note": {
              "type": "string",
              "description": "gate=CLOSES で、期限を過ぎているときに画面へ出す言葉。制度の事実（過ぎる前でなければできない）は断定してよいが、その人がもう無理だとは断定しない（ルール15）。"
            }
          },
          "description": "days / months / absolute_date のいずれか一つだけを設定する。月単位のものを日数に換算してはならない。"
        },
        "specialist_bridge": {
          "type": "object",
          "required": [
            "type",
            "concrete_query"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "LAWYER",
                "JUDICIAL_SCRIVENER",
                "TAX_ACCOUNTANT",
                "ADMINISTRATIVE_SCRIVENER",
                "LAND_SURVEYOR",
                "INTERNATIONAL_LAWYER",
                "INTERNATIONAL_TAX_LAWYER"
              ]
            },
            "concrete_query": {
              "type": "string"
            },
            "estimated_cost_range": {
              "type": "string"
            }
          }
        },
        "legal_metadata": {
          "type": "object",
          "required": [
            "verification_status",
            "verified_at",
            "verified_by",
            "source_draft",
            "needs_check"
          ],
          "additionalProperties": false,
          "properties": {
            "verification_status": {
              "enum": [
                "DRAFT",
                "SELF_REVIEWED",
                "SOURCE_VERIFIED",
                "EXPERT_VERIFIED"
              ],
              "description": "DRAFT: 下書き。SELF_REVIEWED: 自分で下調べした。SOURCE_VERIFIED: 官公庁など一次資料で確かめたが専門家の確認は受けていない。EXPERT_VERIFIED: 専門家が確認した。SOURCE_VERIFIED と EXPERT_VERIFIED のときは verified_at と verified_by を必ず入れる。それ以外は null にする。"
            },
            "verified_at": {
              "type": [
                "string",
                "null"
              ],
              "description": "最後に確かめた日（YYYY-MM-DD）"
            },
            "verified_by": {
              "type": [
                "string",
                "null"
              ],
              "description": "誰が、または何によって確かめたか（例: 中小企業庁サイト、〇〇税理士）"
            },
            "source_draft": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_url": {
              "type": "string",
              "description": "確かめた一次資料の場所。SOURCE_VERIFIED のときは入れる。"
            },
            "needs_check": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "in_house_reviewed_at": {
              "type": [
                "string",
                "null"
              ],
              "description": "開発中の内部点検で読んだ日（YYYY-MM-DD）。これは対外的な保証ではない。専門家の確認を受けたことを意味しない。表示にも使わない。"
            }
          }
        },
        "branches": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "paths",
            "note"
          ],
          "description": "この駅から分かれる道。選び方は示さず、どの場面で検討される道かを並べる。",
          "properties": {
            "paths": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "key",
                  "label",
                  "when",
                  "to_text",
                  "basis"
                ],
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string",
                    "description": "道の名前（例：放棄する（相続放棄））"
                  },
                  "when": {
                    "type": "string",
                    "description": "この道が検討される場面。指図ではなく場面を書く"
                  },
                  "to_text": {
                    "type": "string",
                    "description": "行き先（言葉）"
                  },
                  "to_node": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "行き先の駅。地図に無い行き先は null"
                  },
                  "deadline": {
                    "type": "string"
                  },
                  "basis": {
                    "type": "string",
                    "description": "根拠条文"
                  },
                  "aside": {
                    "type": "string",
                    "description": "道の下に小さく出す補足"
                  },
                  "whisker": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "地図に行き先の駅が無いとき、点線の先に出す短い札"
                  },
                  "station": {
                    "type": "string",
                    "description": "ミニ路線図の終点の駅名（短い名詞）"
                  },
                  "rail_tag": {
                    "type": "string",
                    "description": "レールの上に置く札（期限の無い道に使う。例：手続は不要）"
                  }
                }
              }
            },
            "note": {
              "type": "string"
            },
            "origin": {
              "type": "string",
              "description": "ミニ路線図の起点の駅名（短い名詞）"
            },
            "when_label": {
              "type": "string",
              "description": "道の条件の見出し。既定は「検討される場面」。事実で決まる分岐は「当てはまる場合」"
            },
            "footnotes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "共通の一文の下に添える参考情報（任意の配慮など）"
            },
            "siding": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 3,
              "description": "待避線の札（1〜3行）。既定は期間の延長"
            }
          }
        },
        "short_title": {
          "type": "string",
          "description": "地図やドロワーの見出しに使う短い名詞（8字前後）。無ければ title を使う"
        },
        "express": {
          "type": "boolean",
          "description": "急行停車駅（主要駅）なら true、各駅なら false。指定なしは通常の大きさ"
        },
        "important_note": {
          "type": "string",
          "description": "ドロワーの【さらに大事なこと】に出す、人が書いた手引きの文（照合結果とは別）"
        },
        "deadline_boxed": {
          "type": "boolean",
          "description": "地図の期限の札を枠で囲んで目立たせるなら true（見落としやすい期限の駅に使う）"
        }
      }
    }
  }
}
