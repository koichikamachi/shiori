{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "しおり ノード定義スキーマ",
  "type": "object",
  "required": [
    "schema_version",
    "file",
    "nodes"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "file": {
      "type": "string"
    },
    "actor_scope": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/node"
      }
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "stream",
        "actor",
        "title",
        "today_action",
        "exists_if",
        "prerequisites",
        "base_urgency",
        "priority",
        "wait",
        "durability",
        "legal_metadata"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(SELF|FAMILY|SURV)_[A-Z0-9_]+$"
        },
        "stream": {
          "enum": [
            "ESTATE_SUCCESSION",
            "POST_MORTEM_AFFAIRS",
            "BUSINESS_SUCCESSION",
            "CROSS_BORDER",
            "FAMILY_BRIDGING",
            "HANDOVER"
          ]
        },
        "actor": {
          "enum": [
            "SELF",
            "FAMILY_CHILD",
            "RELATIVES",
            "LEGAL_HEIR"
          ]
        },
        "persona_labels": {
          "type": "array",
          "items": {
            "enum": [
              "ALL",
              "PENSIONER",
              "LANDOWNER",
              "BUSINESS_OWNER",
              "FOREIGN_ASSETS",
              "DEBT_CONCERN"
            ]
          },
          "description": "表示用のラベルのみ。出現の判定には使わない。判定は exists_if 一本で行う。"
        },
        "title": {
          "type": "string"
        },
        "today_action": {
          "type": "string"
        },
        "why_only_you": {
          "type": "string",
          "description": "本人にしかできない理由。SELF のノードにのみ置く。"
        },
        "exists_if": {
          "type": [
            "string",
            "null"
          ],
          "description": "null は無条件で存在。式に書けるのは data/schema/conditions.json にあるキーのみ。actor はここに書かない（actor フィールドで絞る）。"
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "同じ actor_scope 内のノードIDのみ。exists_if が偽で存在しないノードは、満たされたものとみなす。"
        },
        "base_urgency": {
          "enum": [
            "MUST_IMMEDIATE",
            "CAN_WAIT"
          ],
          "description": "静的な下限。実際の緊急度は deadline と days_since_death から計算して上書きする。"
        },
        "priority": {
          "type": "integer",
          "description": "小さいほど先。同点は id の昇順で決める。"
        },
        "wait": {
          "type": "object",
          "required": [
            "nature"
          ],
          "additionalProperties": false,
          "properties": {
            "nature": {
              "enum": [
                "NONE",
                "EXTERNAL_WAIT"
              ]
            },
            "reason": {
              "type": "string"
            }
          }
        },
        "durability": {
          "enum": [
            "PERMANENT",
            "REFRESHABLE",
            "VOLATILE"
          ],
          "description": "PERMANENT: 一度で済む。REFRESHABLE: 時が経つと古くなる。VOLATILE: 出来事で無効に戻る。"
        },
        "is_warning_only": {
          "type": "boolean",
          "description": "赤い帯にだけ出し、「今日の3件」には数えないノード。S02 第三部2 は『今日やること』『やらなくてよいこと』『触る前に知っておくこと』を別のものとして渡している。触る前の注意を作業として数えると、3件の枠を一つ潰す。"
        },
        "absent_note": {
          "type": "string",
          "description": "exists_if が偽で、このノードが道筋から消えたときに使う人へ伝える一文。「その作業は要りません」と言えるようにするためのもの。"
        },
        "decided_by_you": {
          "type": "boolean",
          "description": "遺族が自分で決めて動かねばならないか。false なら葬儀社等が主導する。「今日の3件」に数えるのは true のものだけ。"
        },
        "mitigates_nodes": {
          "type": "array",
          "description": "本人画面の表示専用。遺族側の道筋の計算には使わない。計算に効かせるのは相手ノードの exists_if だけである。",
          "items": {
            "type": "object",
            "required": [
              "target_node_id",
              "effect",
              "explanation"
            ],
            "additionalProperties": false,
            "properties": {
              "target_node_id": {
                "type": "string"
              },
              "effect": {
                "enum": [
                  "SKIPPED",
                  "SHORTENED",
                  "RISK_REDUCED"
                ]
              },
              "explanation": {
                "type": "string"
              }
            }
          }
        },
        "irreversibility": {
          "type": "object",
          "required": [
            "is_irreversible",
            "lost_option",
            "warning_fact",
            "warning_exception"
          ],
          "additionalProperties": false,
          "properties": {
            "is_irreversible": {
              "const": true
            },
            "lost_option": {
              "type": "string"
            },
            "warning_fact": {
              "type": "string",
              "description": "因果を断定する一文。「〜すると、〜が失われます」"
            },
            "warning_exception": {
              "type": "string",
              "description": "逃げ道を示す一文。断定した直後に必ず置く。"
            }
          }
        },
        "caution": {
          "type": "object",
          "required": [
            "note"
          ],
          "additionalProperties": false,
          "properties": {
            "note": {
              "type": "string"
            }
          },
          "description": "不可逆ではない注意。irreversibility と混ぜない。"
        },
        "deadline": {
          "type": "object",
          "required": [
            "trigger"
          ],
          "additionalProperties": false,
          "properties": {
            "days": {
              "type": [
                "integer",
                "null"
              ]
            },
            "months": {
              "type": [
                "integer",
                "null"
              ]
            },
            "absolute_date": {
              "type": [
                "string",
                "null"
              ],
              "description": "制度上の暦の期限（YYYY-MM-DD）。死亡日からの相対期限ではなく、法令が定めた固定の日。改正で動くので verified_at とあわせて管理する。"
            },
            "trigger": {
              "type": "string"
            },
            "note": {
              "type": "string"
            },
            "clock": {
              "type": "string",
              "enum": [
                "DEATH",
                "KNOWN"
              ],
              "description": "どの時計で数えるか。DEATH=死亡日から（既定）。KNOWN=自己のために相続の開始があったことを知った時から。順位の繰り上がりで相続人になった人は、死亡から何か月経っていても、その人の期限はそこから始まる。"
            }
          },
          "description": "days / months / absolute_date のいずれか一つだけを設定する。月単位のものを日数に換算してはならない。"
        },
        "specialist_bridge": {
          "type": "object",
          "required": [
            "type",
            "concrete_query"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "LAWYER",
                "JUDICIAL_SCRIVENER",
                "TAX_ACCOUNTANT",
                "ADMINISTRATIVE_SCRIVENER",
                "LAND_SURVEYOR",
                "INTERNATIONAL_LAWYER",
                "INTERNATIONAL_TAX_LAWYER"
              ]
            },
            "concrete_query": {
              "type": "string"
            },
            "estimated_cost_range": {
              "type": "string"
            }
          }
        },
        "legal_metadata": {
          "type": "object",
          "required": [
            "verification_status",
            "verified_at",
            "verified_by",
            "source_draft",
            "needs_check"
          ],
          "additionalProperties": false,
          "properties": {
            "verification_status": {
              "enum": [
                "DRAFT",
                "SELF_REVIEWED",
                "SOURCE_VERIFIED",
                "EXPERT_VERIFIED"
              ],
              "description": "DRAFT: 下書き。SELF_REVIEWED: 自分で下調べした。SOURCE_VERIFIED: 官公庁など一次資料で確かめたが専門家の確認は受けていない。EXPERT_VERIFIED: 専門家が確認した。SOURCE_VERIFIED と EXPERT_VERIFIED のときは verified_at と verified_by を必ず入れる。それ以外は null にする。"
            },
            "verified_at": {
              "type": [
                "string",
                "null"
              ],
              "description": "最後に確かめた日（YYYY-MM-DD）"
            },
            "verified_by": {
              "type": [
                "string",
                "null"
              ],
              "description": "誰が、または何によって確かめたか（例: 中小企業庁サイト、〇〇税理士）"
            },
            "source_draft": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_url": {
              "type": "string",
              "description": "確かめた一次資料の場所。SOURCE_VERIFIED のときは入れる。"
            },
            "needs_check": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
